# URL base del proyecto Supabase (ejemplo: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (segura para exponer en el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL base de la API del backend Spring Boot
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clave pública (site key) de Cloudflare Turnstile para el CAPTCHA de
# registro, inicio de sesión y recuperación. Si se deja vacía, no se muestra.
# La clave secreta va solo en Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
